//@version=6
strategy("BETTA / GAMMA flip", shorttitle = "BETTA/GAMMA", overlay = true,
     pyramiding = 0, default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 100000, max_bars_back = 5000, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// Rules
//  GAMMA (top):
//   1. Take the highest candle (the "top").
//   2. If its low breaks the previous candle's low, the top is GAMMA.
//      Otherwise GAMMA is the next candle whose low breaks the top's low.
//   3. If a later candle's high goes above GAMMA's high, GAMMA is cancelled,
//      that candle becomes the new top, and we go back to step 2.
//  BETTA (bottom) is the same, flipped.
//
//  Always in the market (stop and reverse):
//   - Short → go-long order at GAMMA's high.  Long → go-short order at BETTA's low.
//   - After a flip, the next pivot is searched from the pivot we just used
//     (BETTA is searched from GAMMA onward, GAMMA from BETTA onward).
//   - Diffuser: 1 hour after the active pivot, measure from BETTA's high to that
//     candle's low (GAMMA's low to that candle's high when short).
//     gap = max(10% of range, 3) + 1. The order moves to that candle's low - gap
//     (high + gap when short). It only ever tightens. If the pivot is already older
//     than 1 hour when we enter, the entry candle is measured instead.
//   - A tie (equal high / low) is not a break, so orders sit one tick beyond the level.
// ─────────────────────────────────────────────────────────────────────────────

startTime   = input.time(timestamp("01 Jan 2020 00:00 +0000"), "Start trading from")
diffMinutes = input.int(60, "Diffuser: minutes after pivot", minval = 1)
diffPct     = input.float(10.0, "Diffuser: % of range", minval = 0)
diffMin     = input.float(3.0, "Diffuser: minimum gap (points)", minval = 0)
diffExtra   = input.float(1.0, "Diffuser: extra (points)", minval = 0)
showNext    = input.bool(true, "Show next pivot being tracked")
showBg      = input.bool(true, "Color background by position")

diffBars = math.max(1, math.round(diffMinutes * 60 / timeframe.in_seconds()))
tick     = syminfo.mintick

// One swing point. isTop = true → GAMMA, false → BETTA.
type Swing
    bool  isTop
    bool  started   = false
    float exHigh            // the extreme candle (top / bottom)
    float exLow
    int   exBar
    bool  confirmed = false
    float pHigh             // the GAMMA / BETTA candle itself
    float pLow
    int   pBar

method confirmAt(Swing s, float h, float l, int bi) =>
    s.confirmed := true
    s.pHigh     := h
    s.pLow      := l
    s.pBar      := bi
    s

// A new top / bottom candle. It is the pivot right away if it breaks the previous candle.
method setExtreme(Swing s, float h, float l, float ph, float pl, int bi) =>
    s.started   := true
    s.exHigh    := h
    s.exLow     := l
    s.exBar     := bi
    s.confirmed := false
    if s.isTop ? l < pl : h > ph
        s.confirmAt(h, l, bi)
    s

// Feed one candle to a tracker (pivot not in use yet, so the cancel rule applies).
method feed(Swing s, float h, float l, float ph, float pl, int bi) =>
    if not s.started
        s.setExtreme(h, l, ph, pl, bi)
    else if s.isTop
        if s.confirmed ? h > s.pHigh : h > s.exHigh
            s.setExtreme(h, l, ph, pl, bi)
        else if not s.confirmed and l < s.exLow
            s.confirmAt(h, l, bi)
    else
        if s.confirmed ? l < s.pLow : l < s.exLow
            s.setExtreme(h, l, ph, pl, bi)
        else if not s.confirmed and h > s.exHigh
            s.confirmAt(h, l, bi)
    s

// Feed one candle to the pivot guarding the position: a break flips us instead of
// cancelling, so the only thing left to do is confirm a pivot that is still waiting.
method feedActive(Swing s, float h, float l, int bi) =>
    if s.started and not s.confirmed
        if s.isTop ? l < s.exLow : h > s.exHigh
            s.confirmAt(h, l, bi)
    s

method level(Swing s) =>
    s.isTop ? (s.confirmed ? s.pHigh : s.exHigh) : (s.confirmed ? s.pLow : s.exLow)

var int   dir       = 0      // 1 long, -1 short, 0 waiting for the first trade
var Swing top       = na     // GAMMA: tracker when long, active when short
var Swing bot       = na     // BETTA: tracker when short, active when long
var float goLong    = na
var float goShort   = na
var bool  diffDone  = false
var float diffStop  = na
var int   labeledAt = na

if time >= startTime
    if na(top)
        top := Swing.new(true)
        bot := Swing.new(false)

    // 1) Did the order placed on the previous candle trade? (strict break, see ties)
    bool longHit  = dir <= 0 and not na(goLong)  and high > goLong
    bool shortHit = dir >= 0 and not na(goShort) and low  < goShort
    int  flip     = 0
    if dir == 0
        flip := longHit and shortHit ? (high - open <= open - low ? 1 : -1) : longHit ? 1 : shortHit ? -1 : 0
    else if dir == -1 and longHit
        flip := 1
    else if dir == 1 and shortHit
        flip := -1

    // 2) Feed this candle to the trackers before any flip, so the pivot taking over includes it.
    if dir == 1
        top.feed(high, low, high[1], low[1], bar_index)
    else if dir == -1
        bot.feed(high, low, high[1], low[1], bar_index)
    else
        top.feed(high, low, high[1], low[1], bar_index)
        bot.feed(high, low, high[1], low[1], bar_index)

    // 3) Flip: the tracked pivot becomes active, and the next one is searched from it.
    if flip != 0
        dir      := flip
        diffDone := false
        Swing act    = flip == 1 ? bot : top
        int   anchor = act.confirmed ? act.pBar : act.exBar
        Swing fresh  = Swing.new(flip == 1)
        int   n      = math.min(bar_index - anchor, 4900)
        if n > 0
            for i = n - 1 to 0
                fresh.feed(high[i], low[i], high[i + 1], low[i + 1], bar_index - i)
        if flip == 1
            top := fresh
        else
            bot := fresh
    else if dir == 1
        bot.feedActive(high, low, bar_index)
    else if dir == -1
        top.feedActive(high, low, bar_index)

    // 4) Diffuser, once per active pivot. Measured on the candle 1 hour after the pivot,
    //    or on the entry candle if the pivot was already older than that when we entered.
    if dir != 0
        Swing act = dir == 1 ? bot : top
        if act.confirmed and not diffDone and bar_index >= act.pBar + diffBars
            float ref = dir == 1 ? low : high
            float rng = math.abs(ref - (dir == 1 ? act.pHigh : act.pLow))
            float gap = math.max(rng * diffPct / 100, diffMin) + diffExtra
            diffStop := math.round_to_mintick(dir == 1 ? ref - gap : ref + gap)
            diffDone := true
            label.new(x = bar_index, y = ref, text = "DIFF " + str.tostring(gap, "#.##"), xloc = xloc.bar_index,
                 color = color.new(color.orange, 0), textcolor = color.black, size = size.tiny,
                 style = dir == 1 ? label.style_label_up : label.style_label_down,
                 tooltip = "range " + str.tostring(rng, format.mintick) + "\ngap " + str.tostring(gap, format.mintick) +
                           "\norder " + str.tostring(diffStop, format.mintick))

        // Mark the pivot guarding the position.
        if act.confirmed and (na(labeledAt) or act.pBar != labeledAt)
            labeledAt := act.pBar
            label.new(x = act.pBar, y = dir == 1 ? act.pLow : act.pHigh, text = dir == 1 ? "BETTA" : "GAMMA",
                 xloc = xloc.bar_index, color = dir == 1 ? color.teal : color.red, textcolor = color.white, size = size.small,
                 style = dir == 1 ? label.style_label_up : label.style_label_down,
                 tooltip = (dir == 1 ? "go short below " : "go long above ") + str.tostring(act.level(), format.mintick))

    // 5) Prices for the next candle.
    if dir == 1
        goLong  := na
        goShort := bot.level()
        if diffDone
            goShort := math.max(goShort, diffStop)
    else if dir == -1
        goShort := na
        goLong  := top.level()
        if diffDone
            goLong := math.min(goLong, diffStop)
    else
        goLong  := top.confirmed ? top.pHigh : na
        goShort := bot.confirmed ? bot.pLow : na

    // 6) Orders, one tick beyond the level so an exact touch doesn't fill.
    if dir == 1
        strategy.entry("Short", strategy.short, stop = goShort - tick, comment = diffDone and goShort == diffStop ? "Short (diffuser)" : "Short (BETTA)")
    else if dir == -1
        strategy.entry("Long", strategy.long, stop = goLong + tick, comment = diffDone and goLong == diffStop ? "Long (diffuser)" : "Long (GAMMA)")
    else
        if not na(goLong)
            strategy.entry("Long", strategy.long, stop = goLong + tick, oca_name = "first", oca_type = strategy.oca.cancel, comment = "Long (GAMMA)")
        else
            strategy.cancel("Long")
        if not na(goShort)
            strategy.entry("Short", strategy.short, stop = goShort - tick, oca_name = "first", oca_type = strategy.oca.cancel, comment = "Short (BETTA)")
        else
            strategy.cancel("Short")

plot(dir >= 0 ? goShort : na, "Go-short price", color.red, 2, plot.style_linebr)
plot(dir <= 0 ? goLong : na, "Go-long price", color.teal, 2, plot.style_linebr)
plot(showNext and dir == 1 and not na(top) and top.confirmed ? top.pHigh : na, "Next GAMMA", color.new(color.red, 50), 1, plot.style_circles)
plot(showNext and dir == -1 and not na(bot) and bot.confirmed ? bot.pLow : na, "Next BETTA", color.new(color.teal, 50), 1, plot.style_circles)
bgcolor(showBg ? (dir == 1 ? color.new(color.teal, 92) : dir == -1 ? color.new(color.red, 92) : na) : na)
