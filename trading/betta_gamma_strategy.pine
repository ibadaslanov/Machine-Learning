//@version=6
strategy("BETTA / GAMMA flip", shorttitle = "BETTA/GAMMA", overlay = true,
     pyramiding = 0, default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 100000, max_bars_back = 5000, max_labels_count = 500, max_boxes_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// Rules
//  GAMMA (top):
//   1. Take the highest candle (the "top").
//   2. If its low breaks the previous candle's low, the top is GAMMA.
//      Otherwise GAMMA is the next candle whose low breaks the top's low.
//   3. If a later candle's high goes above GAMMA's high, GAMMA is cancelled,
//      that candle becomes the new top, and we go back to step 2.
//  BETTA (bottom) is the same, flipped.
//
//  Always in the market (stop and reverse):
//   - Short → go-long order at GAMMA's high.  Long → go-short order at BETTA's low.
//   - After a flip, the next pivot is searched from the pivot we just used
//     (BETTA is searched from GAMMA onward, GAMMA from BETTA onward).
//   - Diffuser: 1 hour after BETTA, measure from BETTA's high to that candle's low.
//     gap = max(10% of range, 3) + 1, and the order moves to that candle's low - gap.
//     That candle becomes the new BETTA (inherited) and its 1-hour clock starts.
//   - If a candle goes below the inherited BETTA's low without hitting the order,
//     it starts a new BETTA (same BETTA rule). Once it is confirmed, the order moves
//     to its low and the 1-hour clock restarts from it.
//   - Short side is the same, flipped (GAMMA's low to that candle's high, high + gap).
//   - The diffuser only ever tightens the order. If the pivot is already older than
//     1 hour when we enter, the entry candle is measured.
//   - A tie (equal high / low) is not a break, so orders sit one tick beyond the level.
// ─────────────────────────────────────────────────────────────────────────────

startTime   = input.time(timestamp("01 Jan 2020 00:00 +0000"), "Start trading from")
diffMinutes = input.int(60, "Diffuser: minutes after pivot", minval = 1)
diffPct     = input.float(10.0, "Diffuser: % of range", minval = 0)
diffMin     = input.float(3.0, "Diffuser: minimum gap (points)", minval = 0)
diffExtra   = input.float(1.0, "Diffuser: extra (points)", minval = 0)

diffBars = math.max(1, math.round(diffMinutes * 60 / timeframe.in_seconds()))
tick     = syminfo.mintick

BETTA_COL = #2962FF
GAMMA_COL = #FF9800
BUY_COL   = #089981
SELL_COL  = #F23645

// One swing point. isTop = true → GAMMA, false → BETTA.
type Swing
    bool  isTop     = false
    bool  started   = false
    float exHigh            // the extreme candle (top / bottom)
    float exLow
    int   exBar
    bool  confirmed = false
    float pHigh             // the GAMMA / BETTA candle itself
    float pLow
    int   pBar

method confirmAt(Swing s, float h, float l, int bi) =>
    s.confirmed := true
    s.pHigh     := h
    s.pLow      := l
    s.pBar      := bi
    s

// A new top / bottom candle. It is the pivot right away if it breaks the previous candle.
method setExtreme(Swing s, float h, float l, float ph, float pl, int bi) =>
    s.started   := true
    s.exHigh    := h
    s.exLow     := l
    s.exBar     := bi
    s.confirmed := false
    if s.isTop ? l < pl : h > ph
        s.confirmAt(h, l, bi)
    s

// Feed one candle to a tracker (pivot not in use yet, so the cancel rule applies).
method feed(Swing s, float h, float l, float ph, float pl, int bi) =>
    if not s.started
        s.setExtreme(h, l, ph, pl, bi)
    else if s.isTop
        if s.confirmed ? h > s.pHigh : h > s.exHigh
            s.setExtreme(h, l, ph, pl, bi)
        else if not s.confirmed and l < s.exLow
            s.confirmAt(h, l, bi)
    else
        if s.confirmed ? l < s.pLow : l < s.exLow
            s.setExtreme(h, l, ph, pl, bi)
        else if not s.confirmed and h > s.exHigh
            s.confirmAt(h, l, bi)
    s

// Feed one candle to a pivot that is already guarding the position: a break flips us
// instead of cancelling, so the only thing left to do is confirm it if it is still waiting.
method feedActive(Swing s, float h, float l, int bi) =>
    if s.started and not s.confirmed
        if s.isTop ? l < s.exLow : h > s.exHigh
            s.confirmAt(h, l, bi)
    s

// Box + label around a BETTA (d = 1) or GAMMA (d = -1) candle at time t.
drawPivot(int d, float h, float l, int t, float orderPx) =>
    color c    = d == 1 ? BETTA_COL : GAMMA_COL
    int   half = math.round(timeframe.in_seconds() * 1000 * 0.45)
    box.new(left = t - half, top = h, right = t + half, bottom = l, xloc = xloc.bar_time,
         border_color = c, border_width = 2, bgcolor = color.new(c, 65))
    label.new(x = t, y = d == 1 ? l : h, text = d == 1 ? "BETTA" : "GAMMA", xloc = xloc.bar_time, color = c, textcolor = color.white,
         size = size.small, style = d == 1 ? label.style_label_up : label.style_label_down,
         tooltip = (d == 1 ? "go short below " : "go long above ") + str.tostring(orderPx, format.mintick))

var int   dir       = 0      // 1 long, -1 short, 0 waiting for the first trade
var Swing top       = na     // GAMMA tracker (next pivot when long)
var Swing bot       = na     // BETTA tracker (next pivot when short)
// The pivot guarding the position: BETTA when long, GAMMA when short.
var float aHigh     = na
var float aLow      = na
var int   aBar      = na
var Swing pend      = na     // that pivot if it was still waiting for its confirming candle at entry
var bool  inherited = false  // it came from the diffuser
var Swing beyond    = na     // a new pivot forming beyond an inherited one
var float stopLvl   = na     // flip price: go short below it when long, go long above it when short
var bool  byDiff    = false  // stopLvl was set by the diffuser
var float goLong    = na
var float goShort   = na

if time >= startTime
    if na(top)
        top := Swing.new(true)
        bot := Swing.new(false)

    // 1) Did the order placed on the previous candle trade? (strict break, see ties)
    bool longHit  = dir <= 0 and not na(goLong)  and high > goLong
    bool shortHit = dir >= 0 and not na(goShort) and low  < goShort
    int  flip     = 0
    if dir == 0
        flip := longHit and shortHit ? (high - open <= open - low ? 1 : -1) : longHit ? 1 : shortHit ? -1 : 0
    else if dir == -1 and longHit
        flip := 1
    else if dir == 1 and shortHit
        flip := -1

    // 2) Feed this candle to the trackers before any flip, so the pivot taking over includes it.
    if dir == 1
        top.feed(high, low, high[1], low[1], bar_index)
    else if dir == -1
        bot.feed(high, low, high[1], low[1], bar_index)
    else
        top.feed(high, low, high[1], low[1], bar_index)
        bot.feed(high, low, high[1], low[1], bar_index)

    bool newPivot = false
    // 3) Flip: the tracked pivot starts guarding the position, and the next one is searched from it.
    if flip != 0
        // Executed order and its price. A flip closes the old position and opens the new one.
        float  fill = flip == 1 ? math.max(open, goLong + tick) : math.min(open, goShort - tick)
        string txt  = (flip == 1 ? "BUY " : "SELL ") + str.tostring(fill, format.mintick)
        label.new(x = bar_index, y = flip == 1 ? low : high, text = txt, yloc = flip == 1 ? yloc.belowbar : yloc.abovebar,
             color = flip == 1 ? BUY_COL : SELL_COL, textcolor = color.white, size = size.small,
             style = flip == 1 ? label.style_label_up : label.style_label_down)
        dir       := flip
        inherited := false
        beyond    := na
        byDiff    := false
        Swing src    = flip == 1 ? bot : top
        int   anchor = src.confirmed ? src.pBar : src.exBar
        Swing fresh  = Swing.new(flip == 1)
        int   n      = math.min(bar_index - anchor, 4900)
        if n > 0
            for i = n - 1 to 0
                fresh.feed(high[i], low[i], high[i + 1], low[i + 1], bar_index - i)
        if flip == 1
            top := fresh
        else
            bot := fresh
        if src.confirmed
            aHigh    := src.pHigh
            aLow     := src.pLow
            aBar     := src.pBar
            pend     := na
            stopLvl  := flip == 1 ? aLow : aHigh
            newPivot := true
        else
            aHigh   := na
            aLow    := na
            aBar    := na
            pend    := src
            stopLvl := flip == 1 ? src.exLow : src.exHigh
    else if dir != 0
        if not na(pend)
            // The pivot we entered with gets its confirming candle.
            pend.feedActive(high, low, bar_index)
            if pend.confirmed
                aHigh    := pend.pHigh
                aLow     := pend.pLow
                aBar     := pend.pBar
                pend     := na
                stopLvl  := dir == 1 ? math.max(stopLvl, aLow) : math.min(stopLvl, aHigh)
                byDiff   := false
                newPivot := true
        else if inherited
            // A candle beyond the inherited pivot (but short of the order) starts a new one.
            if na(beyond)
                if dir == 1 ? low < aLow : high > aHigh
                    beyond := Swing.new(dir == -1)
                    beyond.setExtreme(high, low, high[1], low[1], bar_index)
            else
                beyond.feed(high, low, high[1], low[1], bar_index)
            if not na(beyond) and beyond.confirmed
                aHigh     := beyond.pHigh
                aLow      := beyond.pLow
                aBar      := beyond.pBar
                inherited := false
                beyond    := na
                stopLvl   := dir == 1 ? aLow : aHigh
                byDiff    := false
                newPivot  := true

    if newPivot and bar_index - aBar <= 4900
        drawPivot(dir, aHigh, aLow, time[bar_index - aBar], stopLvl)

    // 4) Diffuser: 1 hour after the pivot (or on the entry candle if it was older than that).
    //    This candle becomes the new, inherited pivot and its clock starts.
    if dir != 0 and not na(aBar) and bar_index >= aBar + diffBars
        float ref = dir == 1 ? low : high
        float rng = math.abs(ref - (dir == 1 ? aHigh : aLow))
        float gap = math.max(rng * diffPct / 100, diffMin) + diffExtra
        float lvl = math.round_to_mintick(dir == 1 ? ref - gap : ref + gap)
        if dir == 1 ? lvl > stopLvl : lvl < stopLvl
            stopLvl := lvl
            byDiff  := true
        aHigh     := high
        aLow      := low
        aBar      := bar_index
        inherited := true
        beyond    := na
        drawPivot(dir, high, low, time, stopLvl)

    // 5) Prices for the next candle.
    if dir == 1
        goLong  := na
        goShort := stopLvl
    else if dir == -1
        goShort := na
        goLong  := stopLvl
    else
        goLong  := top.confirmed ? top.pHigh : na
        goShort := bot.confirmed ? bot.pLow : na

    // 6) Orders, one tick beyond the level so an exact touch doesn't fill.
    if dir == 1
        strategy.entry("Short", strategy.short, stop = goShort - tick, comment = byDiff ? "Short (diffuser)" : "Short (BETTA)")
    else if dir == -1
        strategy.entry("Long", strategy.long, stop = goLong + tick, comment = byDiff ? "Long (diffuser)" : "Long (GAMMA)")
    else
        if not na(goLong)
            strategy.entry("Long", strategy.long, stop = goLong + tick, oca_name = "first", oca_type = strategy.oca.cancel, comment = "Long (GAMMA)")
        else
            strategy.cancel("Long")
        if not na(goShort)
            strategy.entry("Short", strategy.short, stop = goShort - tick, oca_name = "first", oca_type = strategy.oca.cancel, comment = "Short (BETTA)")
        else
            strategy.cancel("Short")

// ── Profit table ────────────────────────────────────────────────────────────
var table stats = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 25),
     border_color = color.new(color.gray, 70), border_width = 1)

statRow(int row, string name, string value, color valueCol) =>
    table.cell(stats, 0, row, name, text_color = color.white, text_halign = text.align_left, text_size = size.normal)
    table.cell(stats, 1, row, value, text_color = valueCol, text_halign = text.align_right, text_size = size.normal)

money(float x) =>
    (x >= 0 ? "+" : "") + str.tostring(x, "#,##0.0") + " " + strategy.account_currency

if barstate.islast
    float total  = strategy.netprofit + strategy.openprofit
    int   trades = strategy.closedtrades
    float winPct = trades > 0 ? strategy.wintrades * 100.0 / trades : 0.0
    statRow(0, "Total profit", money(total), total >= 0 ? BUY_COL : SELL_COL)
    statRow(1, "Open trade", money(strategy.openprofit), strategy.openprofit >= 0 ? BUY_COL : SELL_COL)
    statRow(2, "Trades", str.tostring(trades), color.white)
    statRow(3, "Win rate", str.tostring(winPct, "#.#") + "% (" + str.tostring(strategy.wintrades) + "/" + str.tostring(trades) + ")", color.white)
    statRow(4, "Max drawdown", money(-strategy.max_drawdown), SELL_COL)
