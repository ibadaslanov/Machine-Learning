//@version=5
indicator("A: 08:00 range break, hold to 09:00 (dashboard)", overlay=true, max_labels_count=500)

// Strategy A as an indicator (works on the free plan, no strategy tester needed).
// All hours UTC.
//  - 09:00-14:00: levels = high/low of the 08:00 candle (frozen)
//  - 15:00-08:00: levels = previous candle's high/low
//  - The first break after 09:00 opens the trade; one trade per day
//  - Closed at the 09:00 open next day, or at Friday's last close (flat over the weekend)
//  - No entries on the first candle after a market break (its open is not a real price)
// The table shows the trades on the bars loaded on the chart.

sessStart  = input.int(15, "Session starts (UTC)", minval=0, maxval=23)
freezeHr   = input.int(8,  "Freeze hour (UTC)", minval=0, maxval=23)
cycleHr    = input.int(9,  "Cycle hour (UTC): close and restart", minval=0, maxval=23)
bufPct     = input.float(0, "Buffer (% of freeze candle range)", minval=0, step=1) / 100
costPts    = input.float(0.5, "Cost per trade (points)", minval=0, step=0.1)
fromTime   = input.time(timestamp("01 Jan 2019 00:00 +0000"), "Count trades from")
ltf        = input.timeframe("1", "Intrabar timeframe for double breaks", group="Double breaks")
fallback   = input.string("Previous candle colour", "If intrabar data can't decide",
     options=["Previous candle colour", "Level nearest the open"], group="Double breaks")
showLabels = input.bool(true, "Show trade labels")

HOUR = 3600000
inSess(x) => sessStart <= freezeHr ? (x >= sessStart and x <= freezeHr) : (x >= sessStart or x <= freezeHr)
cycleOf(t) => math.floor((t / HOUR - cycleHr) / 24)
weekOf(t)  => math.floor((t / HOUR - 48) / 168)          // weeks start Saturday 00:00 UTC

h         = hour(time, "UTC")
prevGreen = close[1] >= open[1]
prevClose = close[1]
prevHigh  = high[1]
prevLow   = low[1]
prevTime  = time[1]
[ltH, ltL] = request.security_lower_tf(syminfo.tickerid, ltf, [high, low])

// ---------- levels for this candle ----------
var float frzH = na
var float frzL = na
float lvlH = inSess(h) ? prevHigh : frzH
float lvlL = inSess(h) ? prevLow  : frzL

// ---------- state and results ----------
var int   pos       = 0
var float entryPx   = na
var int   entryTime = na
var bool  done      = false
var int   trades    = 0
var int   wins      = 0
var float net       = 0.0
var float grossWin  = 0.0
var float grossLoss = 0.0
var float eq        = 0.0
var float peak      = 0.0
var float maxDD     = 0.0
var int   dblTotal  = 0
var int   dblLtf    = 0
var int   dblFb     = 0
var yearly = map.new<int, float>()
var int firstTime = time

hasPrev  = not na(prevTime)
newWeek  = hasPrev and weekOf(time) != weekOf(prevTime)
newCycle = hasPrev and cycleOf(time) != cycleOf(prevTime)
reopen   = hasPrev and time - prevTime >= 2 * HOUR and math.abs(open - prevClose) < syminfo.mintick / 2

// ---------- 1. exits ----------
float exitPx  = na
int   exitBar = bar_index
int   exitYr  = year(time, "UTC")
float exitY   = pos == 1 ? high : low
string why    = ""
if pos != 0 and newWeek                 // the week ended on the previous candle: close at its close
    exitPx  := prevClose
    exitBar := bar_index - 1
    exitYr  := year(prevTime, "UTC")
    exitY   := pos == 1 ? prevHigh : prevLow
    why     := "week end"
else if pos != 0 and newCycle           // new cycle: close at this candle's open
    exitPx  := open
    why     := str.tostring(cycleHr, "00") + ":00"

if not na(exitPx)
    float p = (exitPx - entryPx) * pos - costPts
    if entryTime >= fromTime
        trades += 1
        net    += p
        if p > 0
            wins     += 1
            grossWin += p
        else
            grossLoss -= p
        eq    += p
        peak  := math.max(peak, eq)
        maxDD := math.max(maxDD, peak - eq)
        yearly.put(exitYr, nz(yearly.get(exitYr)) + p)
    if showLabels
        label.new(exitBar, exitY,
             text="exit " + why + "\n" + (p >= 0 ? "+" : "") + str.tostring(p, "0.0"),
             color=color.new(p >= 0 ? color.lime : color.red, 80), textcolor=p >= 0 ? color.lime : color.red,
             style=pos == 1 ? label.style_label_down : label.style_label_up, size=size.small)
    pos     := 0
    entryPx := na

if newCycle
    done := false

// ---------- 2. entry: first break of the cycle ----------
if pos == 0 and not done and not reopen
    bool up = not na(lvlH) and high > lvlH
    bool dn = not na(lvlL) and low  < lvlL
    int d = 0
    if up and dn
        dblTotal += 1
        if open > lvlH
            d := 1
        else if open < lvlL
            d := -1
        else
            int n = array.size(ltH)
            if n > 0
                for i = 0 to n - 1
                    bool u = array.get(ltH, i) > lvlH
                    bool w = array.get(ltL, i) < lvlL
                    if u and w
                        break                       // both inside one intrabar: still unknown
                    if u
                        d := 1
                        break
                    if w
                        d := -1
                        break
            if d != 0
                dblLtf += 1
            else
                dblFb += 1
                d := fallback == "Previous candle colour" ? (prevGreen ? 1 : -1) : ((lvlH - open) < (open - lvlL) ? 1 : -1)
    else if up
        d := 1
    else if dn
        d := -1
    if d != 0
        pos       := d
        entryPx   := d == 1 ? math.max(lvlH, open) : math.min(lvlL, open)
        entryTime := time
        done      := true
        if showLabels
            label.new(bar_index, d == 1 ? low : high, text=(d == 1 ? "LONG" : "SHORT") + "\n@" + str.tostring(entryPx, format.mintick),
                 color=color.new(d == 1 ? color.green : color.red, 80), textcolor=d == 1 ? color.green : color.red,
                 style=d == 1 ? label.style_label_up : label.style_label_down, size=size.small)

// ---------- 3. freeze AFTER the freeze candle has been judged ----------
if h == freezeHr
    frzH := high + bufPct * (high - low)
    frzL := low  - bufPct * (high - low)

// ---------- 4. visuals ----------
plot(lvlH, "Upper level", color.teal,   1, plot.style_stepline)
plot(lvlL, "Lower level", color.maroon, 1, plot.style_stepline)
bgcolor(inSess(h) ? na : color.new(color.blue, 92), title="Frozen 08:00 levels")

// ---------- 5. dashboard ----------
var table t = table.new(position.top_right, 2, 24, bgcolor=color.new(color.black, 20), border_width=1)
cell(r, a, b, c) =>
    table.cell(t, 0, r, a, text_color=color.white, text_size=size.small)
    table.cell(t, 1, r, b, text_color=c, text_size=size.small)
if barstate.islast
    float pf = grossLoss > 0 ? grossWin / grossLoss : na
    float openPnl = pos != 0 ? (close - entryPx) * pos : na
    cell(0, "Trades", str.tostring(trades), color.white)
    cell(1, "Net points (after cost)", str.tostring(net, "#,##0.0"), net >= 0 ? color.lime : color.red)
    cell(2, "Win rate", trades > 0 ? str.tostring(100.0 * wins / trades, "0.0") + "%" : "-", color.white)
    cell(3, "Average per trade", trades > 0 ? str.tostring(net / trades, "0.00") : "-", color.white)
    cell(4, "Profit factor", na(pf) ? "-" : str.tostring(pf, "0.00"), color.white)
    cell(5, "Max drawdown", str.tostring(maxDD, "#,##0.0"), color.orange)
    cell(6, "Open position", pos == 1 ? "LONG @" + str.tostring(entryPx, format.mintick) : pos == -1 ? "SHORT @" + str.tostring(entryPx, format.mintick) : "flat", color.white)
    cell(7, "Open P&L", na(openPnl) ? "-" : str.tostring(openPnl, "0.0"), na(openPnl) ? color.white : openPnl >= 0 ? color.lime : color.red)
    cell(8, "Double breaks: intrabar / fallback", str.tostring(dblLtf) + " / " + str.tostring(dblFb), dblFb > 0 ? color.orange : color.white)
    cell(9, "First bar on chart", str.format_time(firstTime, "yyyy-MM-dd", "UTC"), color.gray)
    yrs = yearly.keys()
    int r = 10
    for y in yrs
        if r < 24
            float v = yearly.get(y)
            cell(r, str.tostring(y), str.tostring(v, "#,##0.0"), v >= 0 ? color.lime : color.red)
            r += 1
