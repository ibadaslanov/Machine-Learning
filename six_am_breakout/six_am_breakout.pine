//@version=6
strategy("06:00 Breakout + Reverse", overlay = true, pyramiding = 0,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100, initial_capital = 10000)

// Use on a 5-minute chart. Set the timezone to the one your chart shows.
tz      = input.string("UTC", "Timezone (e.g. UTC, Asia/Baku, GMT+4)")
sHour   = input.int(6, "Session hour", minval = 0, maxval = 23)
sMinute = input.int(0, "Session minute", minval = 0, maxval = 55, step = 5)

if timeframe.in_seconds() != 300
    runtime.error("Use a 5-minute chart")

barT  = hour(time, tz) * 60 + minute(time, tz)
sessT = sHour * 60 + sMinute
isRef = barT == (sessT + 1435) % 1440   // the 05:55 candle
isSig = barT == sessT                   // the 06:00 candle

var float refHigh  = na
var float refLow   = na
var float revLevel = na
var int   base     = 0                  // trade count when today's setup was armed

trades = strategy.closedtrades + strategy.opentrades
n      = trades - base                  // trades opened since 06:00 today

// Already reversed once: the reversed trade holds to the next 06:00, no more orders.
if n >= 2
    strategy.cancel_all()
    revLevel := na

// 06:00 candle closed: no breakout means no trade today,
// otherwise move the reverse order to the 06:00 low (long) or high (short).
if isSig
    if n == 0
        strategy.cancel_all()
    else if n == 1
        if strategy.position_size > 0
            revLevel := low
            strategy.entry("Short", strategy.short, stop = low, comment = "Reverse short")
        else if strategy.position_size < 0
            revLevel := high
            strategy.entry("Long", strategy.long, stop = high, comment = "Reverse long")

// 05:55 candle closed: close yesterday's trade at the 06:00 open and arm today's breakout.
// The opposite stop doubles as the reverse order until the 06:00 candle closes.
if isRef
    strategy.cancel_all()
    strategy.close_all(comment = "Next 06:00")
    refHigh  := high
    refLow   := low
    revLevel := na
    base     := trades
    strategy.entry("Long", strategy.long, stop = refHigh, comment = "Break high")
    strategy.entry("Short", strategy.short, stop = refLow, comment = "Break low")

plot(refHigh, "05:55 high", color.teal, 1, plot.style_stepline)
plot(refLow, "05:55 low", color.red, 1, plot.style_stepline)
plot(revLevel, "Reverse order", color.orange, 2, plot.style_linebr)
bgcolor(isSig ? color.new(color.blue, 85) : na, title = "06:00 candle")
