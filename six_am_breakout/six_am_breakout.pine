//@version=6
// pyramiding = 2 so today's breakout order is accepted while yesterday's trade
// (same direction) is still open; that trade closes at the session open.
strategy("Session Breakout + Reverse", overlay = true, pyramiding = 2,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100, initial_capital = 10000)

// One session time per strategy: each trade is held until the same time the next day.
// For several times at once use all_sessions.pine (indicator with the profit table),
// or add this strategy to the chart once per time.
// Use on a 5-minute chart. Set the timezone to the one your chart shows.
tz         = input.string("UTC", "Timezone (e.g. UTC, Asia/Baku, GMT+4)")
sessTime   = input.string("14:00", "Session time (HH:MM)")
maxRev     = input.int(2, "Max reversals per day", minval = 0)
closeAfter = input.bool(true, "Close the trade on the next cross after the last reversal (off = hold to next day)")

if timeframe.in_seconds() != 300
    runtime.error("Use a 5-minute chart")

parts = str.split(str.replace_all(sessTime, " ", ""), ":")
sessT = int(str.tonumber(array.get(parts, 0))) * 60 + int(str.tonumber(array.get(parts, 1)))
if na(sessT) or sessT % 5 != 0
    runtime.error("Bad session time: " + sessTime)

barT  = hour(time, tz) * 60 + minute(time, tz)
isRef = barT == (sessT + 1435) % 1440   // the candle 5 minutes before the session
isSig = barT == sessT                   // the session candle

var float refHigh  = na
var float refLow   = na
var float sigHigh  = na
var float sigLow   = na
var float revLevel = na
var bool  active   = false              // today's setup is running
var int   base     = 0                  // trade count when today's setup was armed
var int   sid      = 0                  // day counter, gives each day its own order IDs
idL = "L" + str.tostring(sid)
idS = "S" + str.tostring(sid)

trades = strategy.closedtrades + strategy.opentrades
n      = trades - base                  // entries today: first trade + each reversal
pos    = strategy.position_size

if isRef
    // Reference candle closed: close yesterday's trade at the session open and arm today's breakout.
    strategy.cancel_all()
    strategy.close(idL, comment = "Next day")
    strategy.close(idS, comment = "Next day")
    sid      += 1
    refHigh  := high
    refLow   := low
    sigHigh  := na
    sigLow   := na
    revLevel := na
    base     := trades
    active   := true
    // One-cancels-other: the first break cancels the other side, so nothing reverses
    // inside the session candle.
    oca = "Break " + str.tostring(sid)
    strategy.entry("L" + str.tostring(sid), strategy.long, stop = refHigh, comment = "Break high",
         oca_name = oca, oca_type = strategy.oca.cancel)
    strategy.entry("S" + str.tostring(sid), strategy.short, stop = refLow, comment = "Break low",
         oca_name = oca, oca_type = strategy.oca.cancel)
else if active
    if isSig
        sigHigh := high
        sigLow  := low
    // The reverse order goes at the session candle's high/low once that candle has closed.
    lvlHigh = na(sigHigh) ? refHigh : sigHigh
    lvlLow  = na(sigLow) ? refLow : sigLow
    if pos == 0
        // No breakout in the session candle, or stopped out: done until tomorrow.
        strategy.cancel_all()
        active   := false
        revLevel := na
    else
        revLevel := pos > 0 ? lvlLow : lvlHigh
        if n - 1 < maxRev
            // Reverse order: long -> sell stop at the session low, short -> buy stop at the session high.
            if pos > 0
                strategy.entry(idS, strategy.short, stop = lvlLow, comment = "Reverse short")
            else
                strategy.entry(idL, strategy.long, stop = lvlHigh, comment = "Reverse long")
        else
            // Reversals used up: the next cross closes the trade (or hold if switched off).
            strategy.cancel(idL)
            strategy.cancel(idS)
            if closeAfter
                strategy.exit("Stop", stop = revLevel, comment = "Stop")
            else
                revLevel := na

plot(refHigh, "Reference high", color.teal, 1, plot.style_stepline)
plot(refLow, "Reference low", color.red, 1, plot.style_stepline)
plot(revLevel, "Reverse / stop", color.orange, 2, plot.style_steplinebr)
bgcolor(isSig ? color.new(color.blue, 85) : na, title = "Session candle")
